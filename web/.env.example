# Copy this file to .env (local dev) or .env.production (build for deploy) and fill in real values.
# Actual .env* files are gitignored by the root .gitignore - never commit real values.

# Cognito user pool used for SRP sign-in (aws-amplify v6, Auth.Cognito).
VITE_COGNITO_USER_POOL_ID=us-east-1_W5xKyfEfo

# Cognito app client id (no client secret - a public SPA client).
VITE_COGNITO_CLIENT_ID=7lb7adu4igumk3loq5i3hfdlr7

# Base URL of the deployed API Gateway HTTP API. Trailing slash optional -
# the app normalizes it before appending "emails" / "emails/{id}/correction".
VITE_API_URL=https://q2wgtll89f.execute-api.us-east-1.amazonaws.com/
